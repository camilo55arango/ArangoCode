/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

# Aislamiento entre orígenes solo en el Estudio Creativo: habilita SharedArrayBuffer y WASM multihilo.
# credentialless (en vez de require-corp) deja cargar Hugging Face, jsDelivr y Google Fonts sin CORP.
/estudio
  Cache-Control: no-cache
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/estudio/*
  Cache-Control: no-cache
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

# JS, CSS y WASM generados por Vite llevan hash en el nombre.
/_app/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable
